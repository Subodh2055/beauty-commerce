# Copy to .env and fill in. Never commit real secrets.

# --- App ---
APP_ENV=development
APP_NAME=Beauty Commerce
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=beauty
POSTGRES_PASSWORD=beauty
POSTGRES_DB=beauty_commerce
# Host ports for the Docker data services (remapped to avoid clashing with local installs)
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
# Host port for the dev nginx entry point (http://localhost). If changed, add the
# new origin (e.g. http://localhost:8080) to CORS_ORIGINS.
NGINX_HOST_PORT=80
DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:15432/beauty_commerce

# --- Redis / Celery ---
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
CELERY_RESULT_BACKEND=redis://localhost:16379/2
# Public catalog/CMS read cache in Redis (writes invalidate it; TTL bounds the rest).
CACHE_ENABLED=true
CACHE_TTL_SECONDS=120
# Nightly beat job purges signed-in carts untouched for this many days.
CART_RETENTION_DAYS=90
# >0 = beat enqueues system.ping every N seconds. compose.dev.yml defaults it to 60;
# unset (0) everywhere else.
# BEAT_HEARTBEAT_SECONDS=60

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
# Session lifetime (all roles): idle window slides on activity, absolute is a hard cap.
SESSION_IDLE_TIMEOUT_MINUTES=40
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# --- Payments ---
# Fake online gateway so eSewa/Khalti/Stripe checkouts work end to end in dev.
# Refused when APP_ENV=production. Callbacks are HMAC-signed with the secret.
PAYMENT_STUB_ENABLED=false
PAYMENT_STUB_SECRET=change-me-dev-stub-secret

# --- Uploads / media ---
UPLOAD_DIR=uploads
MEDIA_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=5

# --- n8n ---
N8N_BASE_URL=http://localhost:5678
# Webhook that receives order events; empty = fall back to SMTP, then to logs.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# --- Tests ---
# DB-backed tests (pytest -m db) need a Postgres they may DROP and recreate;
# the name must end in _test. Unset = those tests are skipped.
# TEST_DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:15432/beauty_commerce_test

# --- Observability ---
SENTRY_DSN=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
