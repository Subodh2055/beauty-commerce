# Copy to .env and fill in. Never commit real secrets.

# --- App ---
APP_ENV=development
APP_NAME=Beauty Commerce
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=beauty
POSTGRES_PASSWORD=beauty
POSTGRES_DB=beauty_commerce
# Host ports for the Docker data services (remapped to avoid clashing with local installs)
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:15432/beauty_commerce

# --- Redis / Celery ---
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
CELERY_RESULT_BACKEND=redis://localhost:16379/2

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Uploads / media ---
UPLOAD_DIR=uploads
MEDIA_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=5

# --- n8n ---
N8N_BASE_URL=http://localhost:5678
# Webhook that receives order events; empty = fall back to SMTP, then to logs.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# --- Observability ---
SENTRY_DSN=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
